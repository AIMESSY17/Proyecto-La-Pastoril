{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/imagenes/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fuentes/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/admin/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    { "source": "/imagenes/granja-campo.jpg", "destination": "/imagenes/huevos-mesa-madera-960.webp", "permanent": true },
    { "source": "/imagenes/huevos-maple.jpg", "destination": "/imagenes/huevos-mesa-madera-960.webp", "permanent": true },
    { "source": "/imagenes/pedido-listo.jpg", "destination": "/imagenes/gallinas-aire-libre-960.webp", "permanent": true },
    { "source": "/imagenes/packaging-campo.jpg", "destination": "/imagenes/gallinas-aire-libre-960.webp", "permanent": true },
    { "source": "/imagenes/maples-granja.jpg", "destination": "/imagenes/gallinas-aire-libre-960.webp", "permanent": true },
    { "source": "/imagenes/huevos-envase.jpg", "destination": "/imagenes/gallinas-aire-libre-960.webp", "permanent": true },
    { "source": "/imagenes/gallinas-cuidado.jpg", "destination": "/imagenes/quien-esta-detras-960.webp", "permanent": true },
    { "source": "/imagenes/maples-preparados.jpg", "destination": "/imagenes/codorniz-puesto-960.webp", "permanent": true },
    { "source": "/imagenes/codornices.jpg", "destination": "/imagenes/granjero-gallinas-960.webp", "permanent": true },
    { "source": "/imagenes/gallinas-campo.jpg", "destination": "/imagenes/codorniz-packs-960.webp", "permanent": true },
    { "source": "/imagenes/huevos-campo.jpg", "destination": "/imagenes/codorniz-packs-960.webp", "permanent": true },
    { "source": "/imagenes/huevos-vista-superior.jpg", "destination": "/imagenes/huevos-paja-740.webp", "permanent": true },
    { "source": "/imagenes/huevos-gallina.jpg", "destination": "/imagenes/huevos-canasta-452.webp", "permanent": true },
    { "source": "/imagenes/huevos-codorniz.jpg", "destination": "/imagenes/canasta-granero-360.webp", "permanent": true }
  ]
}
